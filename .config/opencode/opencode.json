{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    {
      "action": "provider.use",
      "resource": "cloudflare-ai-gateway",
      "effect": "deny"
    }
  ],
  "default_agent": "yapper",
  "agents": {
    "build": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "providers": {
    "bedrock-mantle": {
      "package": "aisdk:@ai-sdk/openai",
      "name": "Bedrock Mantle",
      "settings": {
        "baseURL": "https://bedrock-mantle.us-east-2.api.aws/openai/v1"
      },
      "models": {
        "openai.gpt-5.5": {
          "name": "GPT 5.5"
        }
      }
    },
    "amazon-bedrock": {
      "settings": {
        "region": "us-east-1",
        "profile": "razer-csvc"
      }
    },
    "lmstudio": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "settings": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "Qwen 3.5 9B"
        },
        "google/gemma-4-e4b": {
          "name": "Gemma 4 E4B"
        },
        "openai/gpt-oss-20b": {
          "name": "GPT OSS 20B"
        }
      }
    },
    "framework": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Framework Desktop",
      "settings": {
        "baseURL": "http://framework.home.lan:8080/v1"
      },
      "models": {
        "Qwen3.8-Flash-Next": {
          "name": "Qwen 3.8 Flash Next"
        },
        "Qwen3.8-27B": {
          "name": "Qwen 3.8 27B"
        },
        "Qwen3.6-35B-A3B": {
          "name": "Qwen 3.6 35B A3B"
        },
        "Gemma-4-E4B": {
          "name": "Gemma 4 E4B"
        }
      }
    },
    "halogen-flash-server": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Halogen Flash Server",
      "settings": {
        "baseURL": "http://framework.home.lan:8731/v1"
      },
      "models": {
        "halogen-qwen3.8-flash-next": {
          "name": "Qwen 3.8 Flash Next (Halogen)"
        }
      }
    },
    "yescale": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "YEScale",
      "settings": {
        "baseURL": "https://api.yescale.io/v1"
      },
      "models": {
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro"
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash"
        },
        "deepseek-v4-pro": {
          "name": "Deepseek v4 Pro"
        },
        "MiniMax-M2.7": {
          "name": "MiniMax M2.7"
        },
        "glm-5.3": {
          "name": "GLM 5.3"
        }
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "knowledge-base",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "research",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "~/Repo/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find * -exec *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "echo *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "wc *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sort *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uniq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tree *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "file *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "which *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cut *",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Repo/**",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todoread",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_pods_list_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_pods_get",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_pods_log",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_resources_list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_resources_get",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_namespaces_list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "kubernetes_configuration_contexts_list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "excalidraw_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "duckduckgo_*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "kubernetes": {
        "type": "local",
        "command": [
          "uvx",
          "kubernetes-mcp-server@latest",
          "--read-only"
        ],
        "disabled": true,
        "environment": {}
      },
      "excalidraw": {
        "type": "remote",
        "url": "https://mcp.excalidraw.com",
        "disabled": true
      },
      "duckduckgo": {
        "type": "local",
        "command": [
          "uvx",
          "duckduckgo-mcp-server"
        ],
        "disabled": false,
        "environment": {
          "DDG_SAFE_SEARCH": "STRICT",
          "DDG_REGION": "en-us"
        }
      }
    }
  }
}
